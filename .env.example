DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
PORT=8000
GUNICORN_WORKERS=3

POSTGRES_DB=cinema_db
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

FASTAPI_APP_NAME=FastAPI Core Service
FASTAPI_DEBUG=false
FASTAPI_LOG_LEVEL=INFO
FASTAPI_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
FASTAPI_SECRET_KEY=fastapi-dev-secret-change-in-prod
FASTAPI_PORT=8001
FASTAPI_DATABASE_URL=postgresql+asyncpg://cinema_user:cinema_password@db:5432/cinema_db
FASTAPI_DJANGO_API_URL=http://web:8000/api
FASTAPI_DJANGO_API_TIMEOUT=5.0
FASTAPI_DJANGO_MOVIES_ENDPOINT=/movies/movies/
FASTAPI_UGC_API_URL=http://ugc_service:5001/api/v1
FASTAPI_UGC_API_TIMEOUT=3.0
FASTAPI_JWT_ALGORITHM=HS256
FASTAPI_ACCESS_TOKEN_EXPIRE_MINUTES=30
FASTAPI_REFRESH_TOKEN_EXPIRE_DAYS=7
